# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database settings
DB_NAME=interrail_kz
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost  # Use 'db' when running with docker-compose
DB_PORT=5432

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Settings
# Extra browser origins allowed to call this API with credentials, comma-separated.
# These are ADDED to the production origins hardcoded in settings.py — you cannot
# lock the frontend out by setting this, only widen the list.
# Add an origin here rather than turning on CORS_ALLOW_ALL_ORIGINS: that flag
# bypasses the list entirely and hands the API to any site the user happens to visit.
CORS_EXTRA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO

# Munich Exhibition API (required — Django will not start without these)
MUNICH_API_BASE_URL=https://munich-api.example.com
MUNICH_API_USERNAME=your-munich-email
MUNICH_API_PASSWORD=your-munich-password
MUNICH_API_TIMEOUT=30
